# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=log_level_here

# Discord channel id that receives WARNING and above logs. Leave empty to disable.
LOGS_CHANNEL_ID=your_logs_channel_id_here

# Discord Bot Configuration
DISCORD_API_TOKEN=your_discord_bot_token_here

# Discord Application ID
DISCORD_APPLICATION_ID=your_discord_application_id_here

# Discord Public Key
DISCORD_PUBLIC_KEY=your_discord_public_key_here

# LeetCode Daily Task Configuration
LEETCODE_FORUM_ID=your_forum_id_here

# Event Notifications Configuration
COMMUNITY_EVENTS_CHANNEL_ID=your_community_events_channel_id_here

# Welcome Messages Configuration
# Channel mentioned inside the welcome text (e.g. the "introduce yourself" channel).
SAY_HI_CHANNEL=your_say_hi_channel_here
# Whether to post the public welcome message when a new member joins (true/false). Default: false.
WELCOME_MESSAGE_ENABLED=false
# Channel ID where the public welcome message is posted. If unset, the public welcome is skipped.
# (The direct-message welcome is always sent regardless of this setting.)
WELCOME_CHANNEL_ID=your_welcome_channel_id_here

# Admin Join Notifications Configuration
# Whether to notify a private admin channel when a new member joins (true/false). Default: false.
ADMIN_JOIN_NOTIFICATION_ENABLED=false
# Private admin channel ID where join notifications are posted. Required when notifications are enabled.
ADMIN_JOIN_NOTIFICATION_CHANNEL_ID=your_admin_notification_channel_id_here

# Azure Storage Account Connection String
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string_here
