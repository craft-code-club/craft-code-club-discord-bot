{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "init-env",
            "type": "shell",
            "windows": {
                "command": "pwsh",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}/init-env.ps1"
                ]
            },
            "linux": {
                "command": "bash",
                "args": [
                    "${workspaceFolder}/init-env.sh"
                ]
            },
            "osx": {
                "command": "bash",
                "args": [
                    "${workspaceFolder}/init-env.sh"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "azurite: up",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "up",
                "-d",
                "--wait",
                "azurite"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            // Requires the Azure Functions Core Tools (`func`), and Azurite for
            // the queue and table bindings.
            "label": "func: host start",
            "type": "shell",
            "command": "func",
            "args": [
                "start",
                "--python",
                "--port",
                "7071"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src",
                "env": {
                    "languageWorkers__python__arguments": "-m debugpy --listen 127.0.0.1:9091"
                }
            },
            "dependsOn": [
                "init-env",
                "azurite: up"
            ],
            "dependsOrder": "sequence",
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": "\\b\\B",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Starting Rpc server.*",
                    "endsPattern": "^.*Host lock lease acquired.*|^.*Worker process started and initialized.*"
                }
            }
        }
    ]
}
